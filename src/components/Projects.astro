---
const projects = [
  {
    name: 'project-takoyaki-obfuscator',
    description: 'LLVM-based code obfuscator using Mixed Boolean-Arithmetic (MBA) transformations. Supports linear, polynomial, and non-polynomial MBA passes.',
    language: 'C++',
    href: 'https://github.com/project-takoyaki/project-takoyaki-obfuscator',
    tags: ['llvm', 'obfuscation', 'mba'],
  },
  {
    name: 'project-takoyaki-aimbot',
    description: 'Game memory exploitation research. Low-level memory reading and input simulation techniques.',
    language: 'C++',
    href: 'https://github.com/project-takoyaki/project-takoyaki-aimbot',
    tags: ['memory', 'research'],
  },
  {
    name: 'project-takoyaki-botnet',
    description: 'Proof-of-concept peer-to-peer botnet using libp2p with Kademlia DHT for peer discovery and Dilithium post-quantum cryptography for command signing.',
    language: 'Rust',
    href: 'https://github.com/project-takoyaki/project-takoyaki-botnet',
    tags: ['p2p', 'kademlia', 'post-quantum', 'lua'],
  },
];

const langColors: Record<string, string> = {
  'C++': 'bg-blue-400',
  'Rust': 'bg-orange-400',
};
---

<section class="mx-auto max-w-3xl px-6 pb-20">
  <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Projects</h2>

  <div class="mt-6 space-y-3">
    {projects.map((project) => (
      <a
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group block rounded-lg border bg-card p-5 transition-colors hover:border-rose-500/40"
      >
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <h3 class="truncate font-mono text-sm font-medium group-hover:text-rose-500 transition-colors">
                {project.name}
              </h3>
              <svg class="h-3 w-3 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </div>
            <p class="mt-1.5 text-sm text-muted-foreground">{project.description}</p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
                <span class={`inline-block h-2 w-2 rounded-full ${langColors[project.language] || 'bg-gray-400'}`}></span>
                {project.language}
              </span>
              {project.tags.map((tag) => (
                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
