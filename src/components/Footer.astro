---
const year = new Date().getFullYear();
---

<footer class="border-t">
  <div class="mx-auto max-w-3xl px-6 py-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="font-mono text-xs text-muted-foreground">
        &copy; {year} Project Takoyaki Technologies
      </p>
      <div class="flex gap-4">
        <a href="https://github.com/project-takoyaki" class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground">
          GitHub
        </a>
        <a href="https://cloud.takoyaki.io" class="font-mono text-xs text-muted-foreground transition-colors hover:text-foreground">
          Cloud
        </a>
      </div>
    </div>
  </div>
</footer>
